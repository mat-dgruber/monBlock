# .env.example — fonte canônica: templates/harness/env.example (1password-credentials-guide.md §1 passo 4), instalado por OP-03
# Variáveis públicas em texto puro; segredos como referências op://<Cofre>/<Item>/<campo> injetadas via `op run -- <comando>`
APP_ENV=local
APP_DEBUG=true
MONBLOCK_BLOCK_PORT=49152
MONBLOCK_IPC_SOCKET=/var/run/monblockd.sock

# Segredos do monBlock injetados em RAM via 1Password CLI (`op run -- <comando>`):
TELEGRAM_BOT_TOKEN=op://monBlock/TelegramBot/token
MONBLOCK_HMAC_SECRET=op://monBlock/PartnerAuth/hmac_secret
MONBLOCK_PARTNER_MASTER_PEPPER=op://monBlock/PartnerAuth/master_pepper
