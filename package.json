{
  "name": "monblock",
  "version": "0.9.1",
  "license": "UNLICENSED",
  "author": "Matheus Diniz",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "electron": "npm run build && electron .",
    "start": "npm run electron",
    "test": "vitest run --dir tests",
    "test:unit": "vitest run tests/domain tests/enforcers",
    "test:integration": "vitest run tests/server",
    "typecheck": "tsc --noEmit",
    "build:daemon": "sh scripts/build-daemon-sea.sh",
    "build:pkg": "sh scripts/build-pkg.sh",
    "build:app": "sh scripts/build-app.sh",
    "build:daemon:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-daemon-sea.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.2.2",
    "esbuild": "0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
