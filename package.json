{
  "name": "monblock",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/renderer/index.html dist/renderer/index.html && cp src/preload/preload-bridge.cjs dist/preload/preload-bridge.cjs",
    "electron": "npm run build && electron .",
    "start": "npm run electron",
    "test": "vitest run --dir tests",
    "test:unit": "vitest run tests/domain tests/enforcers",
    "test:integration": "vitest run tests/server",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.2.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
