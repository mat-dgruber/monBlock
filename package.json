{
  "name": "monblock",
  "version": "0.7.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/renderer/index.html dist/renderer/index.html && cp src/renderer/renderer.css dist/renderer/renderer.css && cp src/renderer/renderer-init.js dist/renderer/renderer-init.js && cp src/preload/preload-bridge.cjs dist/preload/preload-bridge.cjs",
    "electron": "npm run build && electron .",
    "start": "npm run electron",
    "test": "vitest run --dir tests",
    "test:unit": "vitest run tests/domain tests/enforcers",
    "test:integration": "vitest run tests/server",
    "typecheck": "tsc --noEmit",
    "build:daemon": "sh scripts/build-daemon-sea.sh",
    "build:pkg": "sh scripts/build-pkg.sh",
    "build:app": "sh scripts/build-app.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.2.2",
    "esbuild": "0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
