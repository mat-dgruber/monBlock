<?xml version="1.0" encoding="utf-8"?>
<!-- Instalador do monblockd, montado pelo scripts/build-pkg.sh (productbuild em modo distribuição). -->
<installer-gui-script minSpecVersion="1">
    <title>monBlock — Serviço de proteção</title>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.ccat.monblock.daemon"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.ccat.monblock.daemon" visible="false">
        <pkg-ref id="com.ccat.monblock.daemon"/>
    </choice>
    <pkg-ref id="com.ccat.monblock.daemon" onConclusion="none">monblockd-component.pkg</pkg-ref>
</installer-gui-script>
